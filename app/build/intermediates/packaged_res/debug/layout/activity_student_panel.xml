<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/normal_bg">

    <!-- Normal Content -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/normalContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Toolbar -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/studentAppBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/admin_primary"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/studentToolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="@string/student_panel"
                app:titleTextColor="@color/white"
                app:navigationIcon="?attr/homeAsUpIndicator"
                app:navigationIconTint="@color/white" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Status Icon -->
        <ImageView
            android:id="@+id/ivStatusIcon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_shield_check"
            android:contentDescription="Status"
            app:layout_constraintTop_toBottomOf="@id/studentAppBarLayout"
            app:layout_constraintBottom_toTopOf="@id/tvAllClear"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:tint="@color/medical_alert" />

        <!-- All Clear Label -->
        <TextView
            android:id="@+id/tvAllClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/all_clear"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-black"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/ivStatusIcon"
            app:layout_constraintBottom_toTopOf="@id/tvLastAlert"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Last Alert Info -->
        <TextView
            android:id="@+id/tvLastAlert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_active_alerts"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvAllClear"
            app:layout_constraintBottom_toTopOf="@id/safeStatusLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Safe/Unsafe Buttons (visible after dismiss) -->
        <LinearLayout
            android:id="@+id/safeStatusLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvLastAlert"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/are_you_safe"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btnIAmSafe"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/i_am_safe"
                    android:backgroundTint="@color/medical_alert"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnINeedHelp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/i_need_help"
                    android:backgroundTint="@color/fire_alert"
                    android:layout_marginStart="8dp" />

            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Alert Overlay (initially GONE) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/alertOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:paddingTop="80dp">

        <!-- Alert Icon -->
        <ImageView
            android:id="@+id/ivAlertIcon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_fire"
            android:contentDescription="Alert Icon"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@color/white" />

        <!-- Alert Type Text -->
        <TextView
            android:id="@+id/tvAlertType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FIRE ALERT"
            android:textSize="42sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:fontFamily="sans-serif-black"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/ivAlertIcon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Location Text -->
        <TextView
            android:id="@+id/tvAlertLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Location: ---"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvAlertType"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Timestamp -->
        <TextView
            android:id="@+id/tvAlertTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alert Time: --:--:--"
            android:textSize="13sp"
            android:textColor="@color/white_70"
            android:fontFamily="sans-serif"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvAlertLocation"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Instructions ScrollView -->
        <ScrollView
            android:id="@+id/scrollInstructions"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="8dp"
            android:fadeScrollbars="false"
            app:layout_constraintTop_toBottomOf="@id/tvAlertTimestamp"
            app:layout_constraintBottom_toTopOf="@id/btnDismiss"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fire_instructions"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="4dp" />

        </ScrollView>

        <!-- Dismiss Button -->
        <Button
            android:id="@+id/btnDismiss"
            android:layout_width="200dp"
            android:layout_height="52dp"
            android:text="@string/dismiss"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/dismiss_button"
            android:textAllCaps="true"
            android:fontFamily="sans-serif-bold"
            android:background="@drawable/bg_dismiss_button"
            android:elevation="4dp"
            android:layout_marginBottom="40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
